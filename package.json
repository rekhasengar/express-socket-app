{
  "name": "express-ts-sql",
  "title": "express typescript boilerplate with sql db",
  "version": "0.0.0",
  "description": "Ready to use boilerplate with sql database integrated using typeorm",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "prebuild": "rm -rf ./dist",
    "build": "tsc --build ./tsconfig.build.json && resolve-tspaths --project ./tsconfig.build.json ",
    "start": "NODE_ENV=production TS_NODE_PROJECT=./tsconfig.build.json node -r ts-node/register/transpile-only -r tsconfig-paths/register dist/src/index",
    "start:debug": "NODE_ENV=development TS_NODE_PROJECT=./tsconfig.build.json TS_NODE_FILES=true node -r ts-node/register -r tsconfig-paths/register  --inspect=localhost:9229  src/index",
    "start:dev": "NODE_ENV=development ./script/ts-node.sh src/index",
    "dev": "nodemon",
    "test": "NODE_ENV=test DOTENV_CONFIG_PATH=$(pwd)/test/.env node --expose-gc --max-old-space-size=6044  node_modules/.bin/jest  --logHeapUsage  -i --detectOpenHandles --forceExit --config jest.config.js",
    "test:build": "yarn run prebuild  &&  tsc --build ./tsconfig.spec.json",
    "test:debug": "NODE_ENV=test DOTENV_CONFIG_PATH=$(pwd)/test/.env   node --inspect=localhost:9229 --inspect-brk  node_modules/.bin/jest --colors --no-coverage  --ci -i --detectOpenHandles --forceExit --config jest.config.js",
    "test:only": "NODE_ENV=test DOTENV_CONFIG_PATH=$(pwd)/test/.env TERM=dumb   node --max-old-space-size=6044  node_modules/.bin/jest  -i --colors --no-coverage --no-verbose  --detectOpenHandles --forceExit --config jest.config.js",
    "test:setup": "NODE_ENV=test DOTENV_CONFIG_PATH=$(pwd)/test/.env  ./script/testSetup.sh",
    "lint:check": "yarn lint:exec  .",
    "lint:ci": "yarn lint:exec  package.json $(git diff HEAD^ --diff-filter=d --name-only | tr '\n' ' ')",
    "lint:exec": "./node_modules/.bin/eslint --ext .tsx --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write src/**/*.ts",
    "db:migrate": "yarn run build  && ./script/migrate.sh",
    "db:seed": "yarn run build  && ./script/seed.sh",
    "migration:generate": "DEBUG=typeorm:* typeorm-ts-node-commonjs migration:generate ./src/database/mysql/migrations/Refactor -d ./src/database/mysql/typeormConfig.ts",
    "migration:run": "DEBUG=typeorm:* typeorm-ts-node-commonjs migration:run -d ./src/database/mysql/typeormConfig.ts"
  },
  "author": "MindPath – Intelligent Solutions <engineering@mindpathtech.com>",
  "homepage": "",
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [],
  "license": "MIT",
  "maintainers": [
    "MindPath – Intelligent Solutions <engineering@mindpathtech.com>"
  ],
  "dependencies": {
    "@mindpath/logger": "^0.0.3",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "blocked-at": "^1.2.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-joi-swagger-spec": "^0.0.0",
    "helmet": "^8.0.0",
    "http-status-codes": "^2.3.0",
    "joi": "^17.13.3",
    "joi-to-swagger": "^6.2.0",
    "jsonwebtoken": "^9.0.2",
    "lint": "^0.8.19",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "mysql2": "^3.12.0",
    "node-cache": "^5.1.2",
    "nodemailer": "^6.9.16",
    "response-time": "^2.3.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "swagger-generator-express": "^2.1.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.20",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/blocked-at": "^1.0.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/lodash": "^4.17.14",
    "@types/nock": "^11.1.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^6.4.17",
    "@types/response-time": "^2.3.8",
    "@types/sinon": "^17.0.3",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/uuid": "^10.0.0",
    "@types/validator": "^13.12.2",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "jest": "^29.7.0",
    "nock": "^13.5.6",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2",
    "resolve-tspaths": "^0.8.23",
    "sequelize-cli": "^6.6.2",
    "sinon": "^19.0.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.2.0",
    "tsconfig-paths": "^4.2.0",
    "tslint": "^6.1.3",
    "typescript": "^5.7.3"
  },
  "files": [
    "dist/src/*",
    "README.md"
  ],
  "bugs": {
    "url": "https://github.com/mindpath-tech/logger/issues"
  }
}
